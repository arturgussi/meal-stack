          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/restaurants",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "restaurants"]
            },
