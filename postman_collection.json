{
  "info": {
    "name": "Meal Stack API",
    "description": "Collection completa da API Meal Stack — gestão de tipos de usuário, usuários, restaurantes e itens do cardápio.",
    "_postman_id": "meal-stack-api-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "userTypeId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "restaurantId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "menuItemId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Tipos de Usuário",
      "description": "Endpoints para gestão de tipos de usuário (CLIENTE, DONO_RESTAURANTE, etc.)",
      "item": [
        {
          "name": "Criar tipo de usuário",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/user-types",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "user-types"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CLIENTE\"\n}"
            },
            "description": "Cria um novo tipo de usuário. Retorna 201 em caso de sucesso e 422 se o nome já estiver cadastrado."
          },
          "response": []
        },
        {
          "name": "Buscar tipo de usuário por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/user-types/{{userTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "user-types", "{{userTypeId}}"]
            },
            "description": "Retorna os dados de um tipo de usuário pelo ID."
          },
          "response": []
        },
        {
          "name": "Buscar tipos de usuário por nome (parcial)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/user-types/name/cliente",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "user-types", "name", "cliente"]
            },
            "description": "Busca tipos de usuário cujo nome contenha o termo (case-insensitive). Retorna 404 se nenhum for encontrado."
          },
          "response": []
        },
        {
          "name": "Listar todos os tipos de usuário",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/user-types",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "user-types"]
            },
            "description": "Retorna a lista completa de tipos de usuário cadastrados."
          },
          "response": []
        },
        {
          "name": "Atualizar tipo de usuário",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/user-types/{{userTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "user-types", "{{userTypeId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"DONO_RESTAURANTE\"\n}"
            },
            "description": "Atualiza o nome de um tipo de usuário pelo ID."
          },
          "response": []
        },
        {
          "name": "Excluir tipo de usuário",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/user-types/{{userTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "user-types", "{{userTypeId}}"]
            },
            "description": "Remove um tipo de usuário pelo ID. Retorna 204 em caso de sucesso."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Usuários",
      "description": "Endpoints para gestão de usuários do sistema.",
      "item": [
        {
          "name": "Criar usuário",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carlos Eduardo Mendes\",\n  \"email\": \"carlos.mendes@email.com.br\",\n  \"login\": \"carlos.mendes\",\n  \"password\": \"senha@123\",\n  \"cpf\": \"74823916054\",\n  \"userType\": {\n    \"id\": 1,\n    \"name\": \"CLIENTE\"\n  },\n  \"streetAddress\": \"Rua das Palmeiras\",\n  \"numberAddress\": 452,\n  \"cityAddress\": \"São Paulo\",\n  \"cepAddress\": \"01310100\"\n}"
            },
            "description": "Cria um novo usuário. CPF, email e login devem ser únicos. O campo `userType` deve referenciar um tipo de usuário existente."
          },
          "response": []
        },
        {
          "name": "Criar usuário — Dono de Restaurante",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fernanda Oliveira Costa\",\n  \"email\": \"fernanda.costa@restaurantes.com.br\",\n  \"login\": \"fernanda.costa\",\n  \"password\": \"restau@456\",\n  \"cpf\": \"38291047562\",\n  \"userType\": {\n    \"id\": 2,\n    \"name\": \"DONO_RESTAURANTE\"\n  },\n  \"streetAddress\": \"Avenida Paulista\",\n  \"numberAddress\": 1578,\n  \"cityAddress\": \"São Paulo\",\n  \"cepAddress\": \"01310200\"\n}"
            },
            "description": "Cria um usuário do tipo DONO_RESTAURANTE, que poderá cadastrar restaurantes."
          },
          "response": []
        },
        {
          "name": "Buscar usuário por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users", "{{userId}}"]
            },
            "description": "Retorna os dados de um usuário pelo ID."
          },
          "response": []
        },
        {
          "name": "Buscar usuários por nome",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/users/name/Carlos",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users", "name", "Carlos"]
            },
            "description": "Busca usuários cujo nome contenha o texto fornecido (case-insensitive)."
          },
          "response": []
        },
        {
          "name": "Listar todos os usuários",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users"]
            },
            "description": "Retorna todos os usuários cadastrados."
          },
          "response": []
        },
        {
          "name": "Atualizar usuário",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users", "{{userId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carlos Eduardo Mendes Silva\",\n  \"email\": \"carlos.mendes@novoemail.com.br\",\n  \"login\": \"carlos.mendes\",\n  \"password\": \"senha@123\",\n  \"cpf\": \"74823916054\",\n  \"userType\": {\n    \"id\": 1,\n    \"name\": \"CLIENTE\"\n  },\n  \"streetAddress\": \"Rua das Flores\",\n  \"numberAddress\": 99,\n  \"cityAddress\": \"Campinas\",\n  \"cepAddress\": \"13010100\"\n}"
            },
            "description": "Atualiza os dados do usuário (exceto senha, CPF e login). Para trocar a senha use PATCH /v1/users/{id}/password."
          },
          "response": []
        },
        {
          "name": "Alterar senha",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/users/{{userId}}/password",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users", "{{userId}}", "password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senhaAtual\": \"senha@123\",\n  \"novaSenha\": \"novaSenha@456\"\n}"
            },
            "description": "Altera a senha do usuário. Requer confirmação da senha atual. Retorna 204 em caso de sucesso e 401 se a senha atual estiver incorreta."
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"carlos.mendes\",\n  \"senha\": \"senha@123\"\n}"
            },
            "description": "Valida as credenciais de login. Retorna os dados do usuário se válido, ou 401 se as credenciais forem inválidas."
          },
          "response": []
        },
        {
          "name": "Excluir usuário",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users", "{{userId}}"]
            },
            "description": "Remove um usuário do sistema. Retorna 204 em caso de sucesso."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Restaurantes",
      "description": "Endpoints para gestão de restaurantes. O dono deve ser um usuário do tipo DONO_RESTAURANTE.",
      "item": [
