    },
    {
      "name": "Itens do Cardápio",
      "description": "Endpoints para gestão de itens do cardápio dos restaurantes.",
      "item": [
        {
          "name": "Criar item no cardápio",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/menu-items",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "menu-items"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lasanha à Bolonhesa\",\n  \"description\": \"Lasanha artesanal com molho bolonhesa de carne bovina, queijo parmesão e molho bechamel\",\n  \"price\": 52.90,\n  \"onlyOnSite\": false,\n  \"photoPath\": \"/imagens/lasanha-bolonhesa.jpg\",\n  \"restaurantId\": 1\n}"
